---
import type { ProjectItem } from '../../lib/content/types';

interface Props {
  initialProjects: ProjectItem[];
}

const { initialProjects } = Astro.props;
---

<section
  id="tab-panel-projects"
  role="tabpanel"
  aria-labelledby="tab-btn-projects"
  hidden
  class="space-y-10"
>
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-5">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="m-0 font-display text-2xl font-semibold text-[var(--text-primary)]">
          Portfolio Projects
        </h2>
        <button
          type="button"
          id="project-new-btn"
          class="min-h-11 border border-[var(--border-strong)] px-3.5 py-2 font-mono-tech text-xs tracking-[0.08em] uppercase text-[var(--text-primary)] hover:bg-[var(--hover-surface)]"
        >
          + New Project
        </button>
      </div>

      <div
        id="cms-projects-empty"
        hidden={initialProjects.length > 0}
        class="border border-[var(--border-light)] bg-[var(--bg-alt)] p-6 text-sm text-[var(--text-secondary)]"
      >
        No projects stored in Supabase yet. Add your first project link using the form.
      </div>

      <ul
        id="cms-projects-list"
        hidden={initialProjects.length === 0}
        class="m-0 list-none border-t border-[var(--border-light)] p-0"
      >
        {
          initialProjects.map((project, idx) => (
            <li
              data-project-id={project.id}
              data-project-json={JSON.stringify(project)}
              class="border-b border-[var(--border-light)] py-4"
            >
              <div class="mb-1 flex items-center justify-between font-mono-tech text-xs uppercase text-[var(--text-muted)]">
                <span>
                  /{String(idx + 1).padStart(2, '0')} &middot; {project.year || 'N/A'}
                </span>
                <span>{project.featured_on_home ? 'HOME + WORK' : 'WORK ONLY'}</span>
              </div>
              <p class="m-0 font-display text-lg font-semibold text-[var(--text-primary)]">
                {project.title}
              </p>
              <p class="mt-1 mb-3 truncate font-mono-tech text-xs text-[var(--text-muted)]">
                {project.external_url}
              </p>
              <div class="flex flex-wrap gap-2">
                <button
                  type="button"
                  data-move-project="-1"
                  disabled={idx === 0}
                  aria-label={`Move ${project.title} up`}
                  class="min-h-11 min-w-11 border border-[var(--border-light)] px-3 py-1 font-mono-tech text-xs uppercase text-[var(--text-primary)]"
                >
                  Up
                </button>
                <button
                  type="button"
                  data-move-project="1"
                  disabled={idx === initialProjects.length - 1}
                  aria-label={`Move ${project.title} down`}
                  class="min-h-11 min-w-11 border border-[var(--border-light)] px-3 py-1 font-mono-tech text-xs uppercase text-[var(--text-primary)]"
                >
                  Down
                </button>
                <button
                  type="button"
                  data-edit-project
                  class="min-h-11 border border-[var(--border-light)] px-3 py-1.5 font-mono-tech text-xs uppercase text-[var(--text-primary)] hover:border-[var(--border-strong)]"
                >
                  Edit
                </button>
                <button
                  type="button"
                  data-delete-project
                  class="min-h-11 border border-[var(--border-light)] px-3 py-1.5 font-mono-tech text-xs uppercase text-[var(--text-muted)] hover:border-[var(--border-strong)] hover:text-[var(--text-primary)]"
                >
                  Delete
                </button>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="border border-[var(--border-light)] bg-[var(--bg-alt)] p-5 sm:p-7 lg:col-span-7">
      <h2 id="project-form-heading" class="mt-0 mb-5 font-display text-2xl font-semibold text-[var(--text-primary)]">
        Add Project
      </h2>

      <form id="cms-project-form" class="space-y-5">
        <input type="hidden" id="project-id" value="" />

        <div>
          <label for="project-title" class="mb-1.5 block font-mono-tech text-xs uppercase text-[var(--text-primary)]">
            Project Title
          </label>
          <input
            id="project-title"
            type="text"
            required
            class="min-h-11 w-full border border-[var(--border-light)] bg-[var(--bg-primary)] px-3 py-2 text-sm text-[var(--text-primary)]"
          />
        </div>

        <div>
          <label for="project-external-url" class="mb-1.5 block font-mono-tech text-xs uppercase text-[var(--text-primary)]">
            External URL (https:// or http://)
          </label>
          <input
            id="project-external-url"
            type="url"
            required
            placeholder="https://github.com/..."
            class="min-h-11 w-full border border-[var(--border-light)] bg-[var(--bg-primary)] px-3 py-2 font-mono-tech text-xs text-[var(--text-primary)]"
          />
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="sm:col-span-2">
            <label for="project-tech" class="mb-1.5 block font-mono-tech text-xs uppercase text-[var(--text-primary)]">
              Tech Stack (comma separated)
            </label>
            <input
              id="project-tech"
              type="text"
              placeholder="DOCKER, TERRAFORM, AWS"
              class="min-h-11 w-full border border-[var(--border-light)] bg-[var(--bg-primary)] px-3 py-2 font-mono-tech text-xs text-[var(--text-primary)]"
            />
          </div>

          <div>
            <label for="project-year" class="mb-1.5 block font-mono-tech text-xs uppercase text-[var(--text-primary)]">
              Year
            </label>
            <input
              id="project-year"
              type="text"
              placeholder="2025"
              class="min-h-11 w-full border border-[var(--border-light)] bg-[var(--bg-primary)] px-3 py-2 font-mono-tech text-xs text-[var(--text-primary)]"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="project-banner-url" class="mb-1.5 block font-mono-tech text-xs uppercase text-[var(--text-primary)]">
              Hover Banner Image URL
            </label>
            <input
              id="project-banner-url"
              type="text"
              placeholder="https://..."
              class="min-h-11 w-full border border-[var(--border-light)] bg-[var(--bg-primary)] px-3 py-2 font-mono-tech text-xs text-[var(--text-primary)]"
            />
          </div>

          <div>
            <label for="project-banner-file" class="mb-1.5 block font-mono-tech text-xs uppercase text-[var(--text-primary)]">
              Upload Banner Image
            </label>
            <input
              id="project-banner-file"
              type="file"
              accept="image/jpeg,image/png,image/webp,image/avif"
              class="min-h-11 w-full border border-[var(--border-light)] bg-[var(--bg-primary)] px-3 py-2 font-mono-tech text-xs text-[var(--text-primary)]"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:items-center">
          <div>
            <label for="project-sort-order" class="mb-1.5 block font-mono-tech text-xs uppercase text-[var(--text-primary)]">
              Sort Order
            </label>
            <input
              id="project-sort-order"
              type="number"
              value={initialProjects.length + 1}
              class="min-h-11 w-full border border-[var(--border-light)] bg-[var(--bg-primary)] px-3 py-2 font-mono-tech text-xs text-[var(--text-primary)]"
            />
          </div>

          <label for="project-featured" class="inline-flex min-h-11 items-center gap-2.5 pt-4 font-mono-tech text-xs uppercase text-[var(--text-primary)]">
            <input id="project-featured" type="checkbox" checked class="h-4 w-4 accent-black" />
            <span>Feature on Home Selected Work</span>
          </label>
        </div>

        <div class="flex justify-end border-t border-[var(--border-light)] pt-4">
          <button type="submit" id="project-save-btn" class="button-primary">
            Save Project
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const form = document.getElementById('cms-project-form');
    const heading = document.getElementById('project-form-heading');
    const idInput = document.getElementById('project-id');
    const titleInput = document.getElementById('project-title');
    const urlInput = document.getElementById('project-external-url');
    const techInput = document.getElementById('project-tech');
    const yearInput = document.getElementById('project-year');
    const bannerInput = document.getElementById('project-banner-url');
    const bannerFile = document.getElementById('project-banner-file');
    const sortInput = document.getElementById('project-sort-order');
    const featuredInput = document.getElementById('project-featured');
    const saveBtn = document.getElementById('project-save-btn');
    const newBtn = document.getElementById('project-new-btn');
    const listEl = document.getElementById('cms-projects-list');

    if (!form || !titleInput || !urlInput) return;

    function resetForm() {
      idInput.value = '';
      heading.textContent = 'Add Project';
      titleInput.value = '';
      urlInput.value = '';
      techInput.value = '';
      yearInput.value = '';
      bannerInput.value = '';
      sortInput.value = String((listEl ? listEl.children.length : 0) + 1);
      featuredInput.checked = true;
    }

    if (newBtn) newBtn.addEventListener('click', resetForm);

    if (bannerFile && bannerInput) {
      bannerFile.addEventListener('change', async function () {
        const file = bannerFile.files && bannerFile.files[0];
        if (!file) return;
        try {
          window.__cms.showStatus('Uploading project banner...', false);
          bannerInput.value = await window.__cms.uploadImage(file, 'projects');
          window.__cms.showStatus('Project banner uploaded.', false);
        } catch (err) {
          window.__cms.showStatus(err && err.message ? err.message : 'Upload failed.', true);
        } finally {
          bannerFile.value = '';
        }
      });
    }

    if (listEl) {
      const items = Array.from(listEl.querySelectorAll('[data-project-id]'));

      listEl.querySelectorAll('[data-edit-project]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const item = btn.closest('[data-project-id]');
          const raw = item && item.getAttribute('data-project-json');
          if (!raw) return;
          const p = JSON.parse(raw);
          idInput.value = p.id;
          heading.textContent = 'Edit Project';
          titleInput.value = p.title || '';
          urlInput.value = p.external_url || '';
          techInput.value = Array.isArray(p.tech_stack) ? p.tech_stack.join(', ') : '';
          yearInput.value = p.year || '';
          bannerInput.value = p.banner_url || '';
          sortInput.value = String(p.sort_order || 0);
          featuredInput.checked = Boolean(p.featured_on_home);
          titleInput.focus();
        });
      });

      listEl.querySelectorAll('[data-move-project]').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          const delta = Number(btn.getAttribute('data-move-project'));
          const item = btn.closest('[data-project-id]');
          const idx = items.indexOf(item);
          const swapIdx = idx + delta;
          if (idx < 0 || swapIdx < 0 || swapIdx >= items.length) return;

          const reordered = items.slice();
          const temp = reordered[idx];
          reordered[idx] = reordered[swapIdx];
          reordered[swapIdx] = temp;

          const payload = reordered.map(function (el, i) {
            return { id: el.getAttribute('data-project-id'), sort_order: i + 1 };
          });
          try {
            await window.__cms.apiJson('/api/cms/projects', 'PUT', { reorder: payload });
            window.location.reload();
          } catch (err) {
            window.__cms.showStatus(err && err.message ? err.message : 'Reorder failed.', true);
          }
        });
      });

      listEl.querySelectorAll('[data-delete-project]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const item = btn.closest('[data-project-id]');
          const id = item && item.getAttribute('data-project-id');
          if (!id) return;
          window.__cms.openDeleteModal(
            'This removes the project entry from Supabase.',
            btn,
            async function () {
              await window.__cms.apiJson('/api/cms/projects', 'DELETE', { id });
              window.location.reload();
            }
          );
        });
      });
    }

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      if (!saveBtn) return;
      saveBtn.disabled = true;
      saveBtn.setAttribute('aria-busy', 'true');
      try {
        const payload = {
          id: idInput.value || undefined,
          title: titleInput.value,
          external_url: urlInput.value,
          tech_stack: techInput.value,
          year: yearInput.value,
          banner_url: bannerInput.value,
          sort_order: Number(sortInput.value) || 0,
          featured_on_home: featuredInput.checked,
        };
        const method = idInput.value ? 'PUT' : 'POST';
        await window.__cms.apiJson('/api/cms/projects', method, payload);
        window.location.reload();
      } catch (err) {
        window.__cms.showStatus(err && err.message ? err.message : 'Save failed.', true);
      } finally {
        saveBtn.disabled = false;
        saveBtn.removeAttribute('aria-busy');
      }
    });
  })();
</script>
