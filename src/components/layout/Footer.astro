---
import type { UiCopy } from '../../lib/content/i18n';
import { formatJakartaTime12h } from '../../lib/motion/clock';

export interface SocialLinkItem {
  label: string;
  url: string;
}

interface Props {
  copy?: UiCopy;
  fullName?: string;
  wordmark?: string;
  socialLinks?: SocialLinkItem[];
}

const {
  fullName = 'AZIS MUHAMAD FADLI',
  wordmark = 'azis',
  socialLinks = [
    { label: 'LINKEDIN', url: 'https://linkedin.com/in/azisfadli-placeholder' },
    { label: 'GITHUB', url: 'https://github.com/azisfadli-placeholder' },
    { label: 'INSTAGRAM', url: 'https://instagram.com/azisfadli-placeholder' },
    { label: 'THREADS', url: 'https://threads.net/@azisfadli-placeholder' },
  ],
} = Astro.props;

const year = new Date().getFullYear();
const initialTime = formatJakartaTime12h(new Date());
const normalizedWordmark = (wordmark || 'azis').trim() || 'azis';
// Scale Playfair Display bold lowercase to span ~85-90% of container width for any wordmark length.
const charFactor = normalizedWordmark.length <= 5 ? 0.43 : 0.45;
const wordmarkCqw = Math.min(50, Math.max(10, Number((88 / (normalizedWordmark.length * charFactor)).toFixed(2))));
---

<footer class="relative z-10 bg-[var(--bg-primary)] text-[var(--text-primary)]">
  <div class="mx-auto flex max-w-7xl flex-col px-4 pt-12 pb-8 sm:px-6 sm:pt-16 sm:pb-12 lg:px-10">
    <div class="font-mono-tech text-[0.6875rem] leading-relaxed tracking-[0.12em] uppercase text-[var(--text-muted)] sm:text-xs">
      <p class="m-0">&copy; {year} — {fullName.toUpperCase()}</p>
      <p class="m-0">
        <time id="footer-gmt7-clock" data-footer-clock class="tabular-nums">{initialTime}</time>
      </p>
    </div>

    <div class="my-8 w-full overflow-x-clip text-center [container-type:inline-size] sm:my-12">
      <p
        aria-hidden="true"
        data-footer-wordmark
        style={`font-size: clamp(2.5rem, ${wordmarkCqw}cqw, 38rem);`}
        class="m-0 font-display leading-none font-bold tracking-[-0.03em] lowercase text-[var(--text-primary)] select-none"
      >
        {normalizedWordmark}
      </p>
    </div>

    <div class="flex justify-end">
      <ul class="m-0 flex list-none flex-wrap items-center justify-end gap-6 p-0 sm:gap-8">
        {
          socialLinks.map((item) => {
            const isHttp = /^https?:\/\//i.test(item.url);
            return (
              <li>
                <a
                  href={item.url}
                  target={isHttp ? '_blank' : undefined}
                  rel={isHttp ? 'noopener noreferrer' : undefined}
                  class="inline-flex min-h-11 items-center font-mono-tech text-[0.6875rem] tracking-[0.15em] uppercase text-[var(--text-muted)] no-underline transition-colors hover:text-[var(--text-primary)] sm:text-xs"
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</footer>

<script>
  import { startJakartaClock } from '../../lib/motion/clock';

  document.querySelectorAll<HTMLElement>('[data-footer-clock]').forEach((el) => {
    startJakartaClock(el);
  });
</script>
