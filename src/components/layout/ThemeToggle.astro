---
import type { UiCopy } from '../../lib/content/i18n';

interface Props {
  copy: UiCopy;
  idPrefix?: string;
  compact?: boolean;
}

const { copy, idPrefix = 'header', compact = false } = Astro.props;
---

<button
  type="button"
  id={`${idPrefix}-theme-toggle`}
  data-theme-toggle
  data-label-light={copy.themeLight}
  data-label-dark={copy.themeDark}
  data-label-prefix={copy.themeLabel}
  aria-pressed="false"
  aria-label={`${copy.themeLabel}: ${copy.themeLight}`}
  class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-none border-0 bg-transparent px-2.5 py-2 font-mono-tech text-xs tracking-[0.1em] uppercase text-[var(--text-muted)] transition-colors hover:bg-[var(--hover-surface)] hover:text-[var(--text-primary)]"
>
  <svg
    data-theme-icon="sun"
    class="h-3.5 w-3.5 shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg
    data-theme-icon="moon"
    class="hidden h-3.5 w-3.5 shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <span data-theme-label class={compact ? 'hidden sm:inline' : ''}>
    {copy.themeLight}
  </span>
</button>
