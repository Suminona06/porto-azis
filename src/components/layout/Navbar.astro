---
import type { Locale, UiCopy } from '../../lib/content/i18n';
import LocaleToggle from './LocaleToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  copy: UiCopy;
  currentPath: string;
}

const { locale, copy, currentPath } = Astro.props;

const normalizedPath = currentPath.split('?')[0] || '/';
const isActive = (target: string): boolean => {
  if (target === '/') return normalizedPath === '/';
  return normalizedPath === target || normalizedPath.startsWith(`${target}/`);
};

const navItems = [
  { href: '/', label: copy.navHome, index: '/01', isBlog: false },
  { href: '/about', label: copy.navAbout, index: '/02', isBlog: false },
  { href: '/work', label: copy.navWork, index: '/03', isBlog: false },
  { href: '/blog', label: copy.navBlog, index: '/04', isBlog: true },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 bg-[var(--bg-primary)]/80 backdrop-blur-sm"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-2 px-4 sm:px-6 lg:px-10">
    <a
      href="/"
      class="inline-flex min-h-11 items-center font-display text-xl font-semibold tracking-tight text-[var(--text-primary)] no-underline sm:text-2xl"
    >
      azis
    </a>

    <nav aria-label={copy.navTitle} class="hidden items-center gap-1 md:flex lg:gap-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'nav-link md:px-2.5 lg:px-4',
              item.isBlog && 'nav-link-blog md:ml-1 lg:ml-2',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <LocaleToggle locale={locale} currentPath={currentPath} />
      <ThemeToggle copy={copy} idPrefix="desktop" />
    </div>

    <div class="flex items-center gap-1.5 md:hidden">
      <LocaleToggle locale={locale} currentPath={currentPath} />
      <ThemeToggle copy={copy} idPrefix="mobile-bar" compact />
      <button
        type="button"
        id="mobile-menu-open-btn"
        data-mobile-menu-open
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label={copy.navMenuOpen}
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-none border-0 bg-transparent text-[var(--text-primary)] transition-colors hover:bg-[var(--hover-surface)]"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-nav-heading"
  hidden
  class="fixed inset-0 z-[var(--z-modal)] flex flex-col justify-between bg-[var(--bg-primary)] px-6 py-5 text-[var(--text-primary)] md:hidden"
>
  <div class="flex items-center justify-between border-b border-[var(--border-light)] pb-4">
    <span
      id="mobile-nav-heading"
      class="font-mono-tech text-xs tracking-[0.14em] uppercase text-[var(--text-muted)]"
    >
      {copy.navTitle}
    </span>
    <button
      type="button"
      id="mobile-menu-close-btn"
      data-mobile-menu-close
      aria-label={copy.navMenuClose}
      class="inline-flex min-h-11 min-w-11 items-center justify-center border border-[var(--border-strong)] bg-transparent text-[var(--text-primary)] transition-colors hover:bg-[var(--hover-surface)]"
    >
      <svg
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <nav aria-label={copy.navTitle} class="my-auto flex flex-col gap-3 py-6">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          data-mobile-nav-link
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'group flex min-h-14 items-baseline justify-between border-b border-[var(--border-light)] py-3 no-underline transition-colors',
            isActive(item.href) ? 'text-[var(--text-primary)]' : 'text-[var(--text-muted)] hover:text-[var(--text-primary)]',
          ]}
        >
          <span class="font-mono-tech text-xs tracking-[0.1em]">{item.index}</span>
          <span class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
            {item.label}
          </span>
        </a>
      ))
    }
  </nav>

  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--border-light)] pt-5">
    <LocaleToggle locale={locale} currentPath={currentPath} />
    <ThemeToggle copy={copy} idPrefix="drawer" />
  </div>
</div>

<script is:inline>
  (function () {
    const openBtn = document.getElementById('mobile-menu-open-btn');
    const drawer = document.getElementById('mobile-nav-drawer');
    const closeBtn = document.getElementById('mobile-menu-close-btn');
    if (!openBtn || !drawer || !closeBtn) return;

    const getFocusable = () =>
      Array.from(
        drawer.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
      );

    function openDrawer() {
      drawer.removeAttribute('hidden');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function closeDrawer(restoreFocus) {
      drawer.setAttribute('hidden', '');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (restoreFocus) openBtn.focus();
    }

    openBtn.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', function () {
      closeDrawer(true);
    });

    drawer.querySelectorAll('[data-mobile-nav-link]').forEach(function (link) {
      link.addEventListener('click', function () {
        closeDrawer(false);
      });
    });

    document.addEventListener('keydown', function (event) {
      if (drawer.hasAttribute('hidden')) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeDrawer(true);
        return;
      }
      if (event.key === 'Tab') {
        const focusable = getFocusable();
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>

