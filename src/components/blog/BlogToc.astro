---
import type { TocHeading } from '../../lib/content/markdown';

interface Props {
  toc: TocHeading[];
  label: string;
}

const { toc, label } = Astro.props;
---

{
  toc.length > 0 && (
    <aside aria-label={label}>
      <div class="mb-8 border border-[var(--border-light)] bg-[var(--bg-alt)] p-4 lg:hidden">
        <details>
          <summary class="flex min-h-11 items-center justify-between font-mono-tech text-xs tracking-[0.1em] uppercase text-[var(--text-primary)]">
            <span>{label}</span>
            <span aria-hidden="true">+</span>
          </summary>
          <nav aria-label={label} class="mt-3 border-t border-[var(--border-light)] pt-3">
            <ul class="m-0 list-none space-y-2 p-0">
              {toc.map((item) => (
                <li class={item.depth === 3 ? 'pl-4' : ''}>
                  <a
                    href={`#${item.id}`}
                    class="inline-block py-1 font-sans-ui text-sm text-[var(--text-secondary)] no-underline hover:text-[var(--text-primary)] hover:underline"
                  >
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>

      <div class="hidden border border-[var(--border-light)] bg-[var(--bg-alt)] p-5 lg:sticky lg:top-24 lg:block">
        <p class="m-0 mb-4 border-b border-[var(--border-light)] pb-3 font-mono-tech text-xs tracking-[0.12em] uppercase text-[var(--text-muted)]">
          {label}
        </p>
        <nav aria-label={label}>
          <ul class="m-0 list-none space-y-2.5 p-0">
            {toc.map((item) => (
              <li class={item.depth === 3 ? 'pl-4' : ''}>
                <a
                  href={`#${item.id}`}
                  class="inline-block font-sans-ui text-sm leading-[1.45] text-[var(--text-secondary)] no-underline hover:text-[var(--text-primary)] hover:underline"
                >
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>
  )
}

