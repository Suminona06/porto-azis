---
interface Props {
  statement: string;
}

const { statement } = Astro.props;
const words = statement.trim().split(/\s+/).filter(Boolean);
---

<section
  class="relative z-10 border-y border-[var(--border-light)] bg-[var(--bg-alt)] py-20 sm:py-24 lg:py-32"
  data-statement-section
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <p
      class="m-0 font-display text-[clamp(1.65rem,4vw,3.5rem)] leading-[1.18] font-semibold tracking-[-0.02em] uppercase"
    >
      {
        words.map((word, index) => (
          <>
            <span
              data-reveal-word
              data-word-index={index}
              class="inline-block"
            >
              {word}
            </span>
            {index < words.length - 1 ? ' ' : ''}
          </>
        ))
      }
    </p>
  </div>
</section>

