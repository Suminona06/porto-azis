---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  ctaLabel: string;
  ctaUrl: string;
  locationLabel?: string;
}

const { eyebrow, title, subtitle, ctaLabel, ctaUrl, locationLabel } = Astro.props;
const isHttp = /^https?:\/\//i.test(ctaUrl);
const arrowSplit = ctaLabel.replace(/\s*→\s*$/, '');
const hasArrow = ctaLabel.includes('→');

const titleWords = title.trim().split(/\s+/).filter(Boolean);
const splitIndex =
  titleWords.length <= 1 ? 0 : titleWords.length >= 4 ? titleWords.length - 2 : 1;
const titleItalic = splitIndex > 0 ? titleWords.slice(0, splitIndex).join(' ') : '';
const titleBold = titleWords.slice(splitIndex).join(' ');
---

<section class="bg-[var(--bg-primary)] py-20 sm:py-28 lg:py-32">
  <div class="mx-auto flex max-w-4xl flex-col items-center px-4 text-center sm:px-6">
    {
      eyebrow && (
        <p class="m-0 mb-4 font-mono-tech text-xs tracking-[0.14em] uppercase text-[var(--text-muted)]">
          {eyebrow}
        </p>
      )
    }

    <h2 class="m-0 text-[clamp(2.25rem,6vw,4.5rem)] leading-[1.04] tracking-[-0.02em] uppercase text-[var(--text-primary)]">
      {
        titleItalic && (
          <>
            <span class="font-display font-normal italic">{titleItalic}</span>{' '}
          </>
        )
      }<span class="font-sans-ui font-bold">{titleBold}</span>
    </h2>

    {
      subtitle && (
        <p class="m-0 mt-5 max-w-xl font-mono-tech text-xs leading-[1.7] tracking-[0.08em] uppercase text-[var(--text-muted)]">
          {subtitle}
        </p>
      )
    }

    <div class="mt-9">
      <a
        href={ctaUrl}
        target={isHttp ? '_blank' : undefined}
        rel={isHttp ? 'noopener noreferrer' : undefined}
        class="button-primary"
      >
        <span>{arrowSplit}</span>
        {
          hasArrow && (
            <svg
              aria-hidden="true"
              class="button-primary-arrow h-3 w-[18px] shrink-0"
              viewBox="0 0 18 12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M1 6h15" />
              <path d="M11.5 1.5L16 6l-4.5 4.5" />
            </svg>
          )
        }
      </a>
    </div>

    {
      locationLabel && (
        <p class="m-0 mt-10 font-mono-tech text-xs tracking-[0.1em] uppercase text-[var(--text-muted)]">
          {locationLabel}
        </p>
      )
    }
  </div>
</section>

