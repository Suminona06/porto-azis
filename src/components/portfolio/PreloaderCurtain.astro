---
/**
 * Every-load monochrome #000000 multilingual preloader and #FFFFFF vertical exit curtain.
 * Active on initial paint whenever html.preloader-active is applied synchronously in <head>,
 * and bypassed immediately when prefers-reduced-motion: reduce is active.
 */
---

<div
  id="preloader-overlay"
  data-preloader-overlay
  aria-hidden="true"
  class="preloader-overlay fixed inset-0 z-[100] flex-col justify-between bg-[#000000] text-[#FFFFFF] select-none"
>
  <div data-preloader-backdrop class="relative flex h-full w-full flex-col justify-between bg-[#000000]">
    <div class="h-12" aria-hidden="true"></div>

    <div class="flex flex-1 items-center justify-center px-4">
      <p
        data-preloader-label
        class="m-0 whitespace-nowrap text-center font-display text-[clamp(2rem,6vw,4.5rem)] leading-none font-semibold tracking-[0.04em] uppercase text-[#FFFFFF]"
      >
        LOADING
      </p>
    </div>

    <div class="relative flex items-end justify-end px-4 pb-6 sm:px-6 lg:px-10 lg:pb-8">
      <span
        data-preloader-counter
        class="font-mono-tech text-xs font-medium tracking-[0.12em] uppercase tabular-nums text-[#FFFFFF] sm:text-sm"
      >
        0%
      </span>
    </div>

    <div
      data-preloader-bar
      style="transform: scaleX(0);"
      class="absolute inset-x-0 bottom-0 h-[3px] w-full origin-left bg-[#FFFFFF]"
    ></div>
  </div>

  <div
    data-preloader-curtain
    style="transform: translateY(100%);"
    class="pointer-events-none fixed inset-0 z-[101] bg-[#FFFFFF]"
  ></div>
</div>

<script>
  import gsap from 'gsap';
  import {
    editorialEase,
    getReducedMotionMediaQuery,
    prefersReducedMotion,
  } from '../../lib/motion/easing';

  declare global {
    interface Window {
      __azisPreloaderDone?: boolean;
    }
  }

  const LABELS = ['LOADING', 'MEMUAT', '로딩 중'] as const;

  function unlockScroll() {
    document.documentElement.classList.remove('preloader-active');
    if ('scrollRestoration' in window.history) {
      window.history.scrollRestoration = 'auto';
    }
  }

  function markDone(overlay: HTMLElement | null) {
    unlockScroll();
    if (overlay) {
      overlay.classList.remove('preloader-exiting');
      overlay.classList.add('preloader-done');
    }
    if (!window.__azisPreloaderDone) {
      window.__azisPreloaderDone = true;
      window.dispatchEvent(new CustomEvent('azis:preloader-complete'));
    }
  }

  function initPreloader() {
    window.__azisPreloaderDone = false;

    const overlay = document.querySelector<HTMLElement>('[data-preloader-overlay]');
    if (!overlay) {
      window.__azisPreloaderDone = true;
      window.dispatchEvent(new CustomEvent('azis:preloader-complete'));
      return;
    }

    const active = document.documentElement.classList.contains('preloader-active');
    if (!active || prefersReducedMotion()) {
      markDone(overlay);
      return;
    }

    if (!window.location.hash) {
      window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
    }

    const backdrop = overlay.querySelector<HTMLElement>('[data-preloader-backdrop]');
    const labelEl = overlay.querySelector<HTMLElement>('[data-preloader-label]');
    const counterEl = overlay.querySelector<HTMLElement>('[data-preloader-counter]');
    const barEl = overlay.querySelector<HTMLElement>('[data-preloader-bar]');
    const curtainEl = overlay.querySelector<HTMLElement>('[data-preloader-curtain]');

    if (!backdrop || !labelEl || !counterEl || !barEl || !curtainEl) {
      markDone(overlay);
      return;
    }

    let finished = false;
    let activeTimeline: gsap.core.Timeline | null = null;

    const mql = getReducedMotionMediaQuery();
    const onReducedMotionChange = (event: MediaQueryListEvent) => {
      if (event.matches && !finished) {
        activeTimeline?.kill();
        complete();
      }
    };
    mql?.addEventListener('change', onReducedMotionChange);

    const complete = () => {
      if (finished) return;
      finished = true;
      window.clearTimeout(failsafeTimer);
      mql?.removeEventListener('change', onReducedMotionChange);
      gsap.set([barEl, curtainEl], { clearProps: 'willChange' });
      markDone(overlay);
    };

    const failsafeTimer = window.setTimeout(() => {
      if (!finished) {
        activeTimeline?.kill();
        complete();
      }
    }, 3200);

    const state = { progress: 0 };
    let lastLabel: (typeof LABELS)[number] = LABELS[0];
    let lastPercent = -1;

    const renderProgress = () => {
      const pct = Math.min(100, Math.max(0, Math.round(state.progress)));
      if (pct !== lastPercent) {
        lastPercent = pct;
        counterEl.textContent = `${pct}%`;
      }

      const nextLabel = pct < 34 ? LABELS[0] : pct < 68 ? LABELS[1] : LABELS[2];
      if (nextLabel !== lastLabel) {
        lastLabel = nextLabel;
        labelEl.textContent = nextLabel;
      }
    };

    gsap.set(barEl, {
      scaleX: 0,
      transformOrigin: '0% 50%',
      force3D: true,
      willChange: 'transform',
    });
    gsap.set(curtainEl, {
      yPercent: 100,
      y: 0,
      force3D: true,
      willChange: 'transform',
    });

    const waitForFonts =
      document.fonts && document.fonts.ready
        ? Promise.race([
            document.fonts.ready,
            new Promise<void>((resolve) => window.setTimeout(resolve, 160)),
          ])
        : Promise.resolve();

    waitForFonts.then(() => {
      if (finished) return;

      let backdropRevealed = false;
      const masterTl = gsap.timeline({ onComplete: complete });
      activeTimeline = masterTl;

      masterTl
        .to(
          state,
          {
            progress: 100,
            duration: 0.92,
            ease: 'power2.inOut',
            onUpdate: renderProgress,
          },
          0,
        )
        .to(
          barEl,
          {
            scaleX: 1,
            duration: 0.92,
            ease: 'power2.inOut',
            force3D: true,
          },
          0,
        )
        .to(
          curtainEl,
          {
            yPercent: -100,
            duration: 0.6,
            ease: editorialEase,
            force3D: true,
            onUpdate() {
              if (!backdropRevealed && this.progress() >= 0.5) {
                backdropRevealed = true;
                overlay.classList.add('preloader-exiting');
                overlay.style.backgroundColor = 'transparent';
                backdrop.style.opacity = '0';
                backdrop.style.visibility = 'hidden';
                unlockScroll();
              }
            },
          },
          '+=0.04',
        );
    });
  }

  initPreloader();
</script>
