---
interface Props {
  roles: string[];
  stack: string[];
}

const { roles, stack } = Astro.props;
const safeRoles = roles.length > 0 ? roles : ['IT SUPPORT', 'DEVOPS', 'CLOUD ENGINEER'];
const safeStack = stack.length > 0 ? stack : ['LINUX', 'DOCKER', 'KUBERNETES', 'TERRAFORM', 'AWS'];
---

<section
  aria-label="Core engineering disciplines and tooling"
  class="overflow-hidden border-b border-[var(--border-light)] bg-[var(--bg-primary)] py-14 sm:py-20"
>
  <div class="marquee-container -mx-6 -rotate-2 border-y border-[var(--border-light)] bg-[var(--bg-primary)] py-4 sm:py-5">
    <div class="marquee-track">
      {
        [0, 1].map((dup) => (
          <div class="flex shrink-0 items-center" aria-hidden={dup === 1 ? 'true' : undefined}>
            {safeRoles.map((role) => (
              <span class="flex items-center font-display text-[clamp(1.75rem,4.5vw,3.75rem)] leading-none font-semibold tracking-[-0.02em] uppercase text-[var(--text-primary)]">
                <span class="px-5 sm:px-8">{role}</span>
                <span aria-hidden="true" class="text-[var(--text-muted)]">/</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="marquee-container -mx-6 mt-4 rotate-1 border-y border-[var(--border-strong)] bg-[var(--bg-inverse)] py-3 text-[var(--text-inverse)] sm:mt-6 sm:py-4">
    <div class="marquee-track-reverse">
      {
        [0, 1].map((dup) => (
          <div class="flex shrink-0 items-center" aria-hidden={dup === 1 ? 'true' : undefined}>
            {safeStack.map((item) => (
              <span class="flex items-center font-mono-tech text-xs tracking-[0.14em] uppercase sm:text-sm">
                <span class="px-5 sm:px-8">{item}</span>
                <span aria-hidden="true" class="opacity-60">&middot;</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

