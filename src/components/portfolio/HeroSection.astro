---
import { pickLocale, type Locale, type UiCopy } from '../../lib/content/i18n';
import type { SiteProfile } from '../../lib/content/types';
import { formatJakartaTime12h } from '../../lib/motion/clock';
import CipherText from '../motion/CipherText.astro';
import BlockMaskReveal from '../motion/BlockMaskReveal.astro';

interface Props {
  profile: SiteProfile;
  locale: Locale;
  copy: UiCopy;
  isPlaceholder: boolean;
}

const { profile, locale, copy, isPlaceholder } = Astro.props;
const roleText = pickLocale(profile.role_en, profile.role_id, locale).trim().toUpperCase();
const bioText = pickLocale(profile.hero_bio_en, profile.hero_bio_id, locale);
const bioWords = bioText.trim().split(/\s+/).filter(Boolean);
const displayName = profile.display_name.trim().toUpperCase();
const locationLabel = profile.location.trim().toUpperCase();
const initialJakartaClock = formatJakartaTime12h(new Date());
---

<section
  class="sticky top-0 z-0 min-h-[100svh] bg-[var(--bg-primary)]"
  data-hero-section
>
  <div class="mx-auto flex min-h-[100svh] max-w-7xl flex-col justify-between overflow-x-clip px-6 pt-24 pb-8 sm:px-10 lg:px-12 lg:pt-28 lg:pb-10">
    {
      isPlaceholder && (
        <div
          role="note"
          class="mb-4 border border-[var(--border-light)] bg-[var(--bg-alt)] px-4 py-2 font-mono-tech text-xs tracking-[0.06em] text-[var(--text-muted)]"
        >
          {copy.placeholderNotice}
        </div>
      )
    }

    {/* Top/Mid-Left Headline Block */}
    <div class="mt-auto mb-auto py-6 sm:py-10">
      <h1 class="m-0 font-display text-[clamp(2.25rem,6.8vw,5.5rem)] leading-[1.04] font-normal tracking-tight uppercase text-[var(--text-primary)]">
        <CipherText
          text={displayName}
          as="span"
          charset="alphabet"
          durationMs={1100}
          frameIntervalMs={42}
          trigger="manual"
          data-hero-cipher
        />
      </h1>

      <div class="mt-2 pl-6 sm:mt-3 sm:pl-12">
        <p class="m-0">
          <BlockMaskReveal
            durationMs={950}
            trigger="manual"
            data-hero-role-reveal
            class="font-sans-ui text-[clamp(1.15rem,3.4vw,2.85rem)] leading-[1.12] font-bold tracking-[-0.02em] uppercase text-[var(--text-primary)]"
          >
            {roleText}
          </BlockMaskReveal>
        </p>
      </div>
    </div>

    {/* Bottom-Right Justified Intro Paragraph + Borderless 3-Slot Meta Bar */}
    <div class="mt-auto pt-4 sm:pt-8">
      <div class="ml-auto w-full max-w-[440px] sm:max-w-[480px]">
        <p class="m-0 text-justify font-sans-ui text-[13px] leading-[1.65] tracking-[0.04em] uppercase text-[var(--hero-bio-color)] sm:text-[14px]">
          {
            bioWords.map((word, idx) => (
              <>
                <span data-hero-bio-word class="inline">
                  {word}
                </span>
                {idx < bioWords.length - 1 ? ' ' : ''}
              </>
            ))
          }
        </p>
      </div>

      <div class="mt-6 grid grid-cols-[1fr_auto_1fr] items-end gap-4 pt-2 font-mono-tech text-[11px] tracking-[0.12em] uppercase text-[var(--text-muted)]">
        <button
          type="button"
          data-hero-location-btn
          data-location-original={locationLabel}
          aria-label={`${copy.basedIn}: ${profile.location}`}
          class="inline-flex min-h-11 items-end justify-self-start border-0 bg-transparent p-0 pb-1 text-left font-mono-tech text-[11px] tracking-[0.12em] uppercase text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)]"
        >
          <span aria-hidden="true" data-hero-location-text>{locationLabel}</span>
        </button>

        <div class="flex items-end justify-self-center pb-1" aria-hidden="true">
          <span class="hero-scroll-line block h-6 w-px bg-[var(--text-primary)]/80"></span>
        </div>

        <time
          data-hero-clock
          class="inline-flex min-h-11 items-end justify-self-end pb-1 tabular-nums text-[11px] tracking-[0.12em] uppercase text-[var(--text-muted)]"
        >
          {initialJakartaClock}
        </time>
      </div>
    </div>
  </div>
</section>

<script>
  import { initLandingMotion } from '../../lib/motion/landing-motion';

  initLandingMotion();
</script>
