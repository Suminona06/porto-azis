---
import { pickLocale, type Locale, type UiCopy } from '../../lib/content/i18n';
import type { SiteProfile } from '../../lib/content/types';
import { formatJakartaTime12h } from '../../lib/motion/clock';

interface Props {
  profile: SiteProfile;
  locale: Locale;
  copy: UiCopy;
  isPlaceholder: boolean;
}

const { profile, locale, copy, isPlaceholder } = Astro.props;
const roleText = pickLocale(profile.role_en, profile.role_id, locale);
const bioText = pickLocale(profile.hero_bio_en, profile.hero_bio_id, locale);
const bioWords = bioText.trim().split(/\s+/).filter(Boolean);
const nameParts = profile.display_name.trim().split(/\s+/);
const firstName = (nameParts[0] || 'AZIS').toUpperCase();
const restName = nameParts.slice(1).join(' ').toUpperCase();
const locationLabel = profile.location.trim().toUpperCase();
const initialJakartaClock = formatJakartaTime12h(new Date());
---

<section
  class="sticky top-0 z-0 min-h-[100svh] border-b border-[var(--border-light)] bg-[var(--bg-primary)]"
  data-hero-section
>
  <div class="mx-auto flex min-h-[100svh] max-w-7xl flex-col justify-between px-4 pt-24 pb-8 sm:px-6 lg:px-10 lg:pt-28 lg:pb-12">
    {
      isPlaceholder && (
        <div
          role="note"
          class="mb-6 border border-[var(--border-light)] bg-[var(--bg-alt)] px-4 py-2.5 font-mono-tech text-xs tracking-[0.06em] text-[var(--text-muted)]"
        >
          {copy.placeholderNotice}
        </div>
      )
    }

    <div class="my-auto grid grid-cols-1 gap-10 py-6 lg:grid-cols-12 lg:items-end lg:gap-8">
      <div class="lg:col-span-8">
        <p class="relative mb-4 inline-block max-w-full overflow-hidden font-sans-ui text-xs font-bold tracking-[0.14em] uppercase text-[var(--text-muted)]">
          <span data-hero-role-text class="inline-block">{roleText}</span>
          <span
            data-hero-role-mask
            aria-hidden="true"
            style="transform: scaleX(0);"
            class="hero-motion-mask pointer-events-none absolute inset-0 bg-[var(--bg-inverse)]"
          ></span>
        </p>

        <h1 class="m-0 font-display text-[clamp(2.75rem,8vw,6.25rem)] leading-[0.94] font-semibold tracking-[-0.03em] uppercase text-[var(--text-primary)]">
          <span class="sr-only">{profile.display_name}</span>
          <span aria-hidden="true" class="block" data-hero-decode data-decode-target={firstName}>
            {firstName}
          </span>
          {
            restName && (
              <span aria-hidden="true" class="block" data-hero-decode data-decode-target={restName}>
                {restName}
              </span>
            )
          }
        </h1>
      </div>

      <div class="lg:col-span-4 lg:pb-2">
        <p class="m-0 max-w-md font-mono-tech text-xs leading-[1.75] tracking-[0.06em] uppercase text-[var(--text-secondary)] sm:text-[13px]">
          {
            bioWords.map((word, idx) => (
              <>
                <span data-hero-bio-word class="inline-block">
                  {word}
                </span>
                {idx < bioWords.length - 1 ? ' ' : ''}
              </>
            ))
          }
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-[var(--border-light)] pt-4 font-mono-tech text-xs tracking-[0.1em] uppercase text-[var(--text-muted)]">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <span>{copy.basedIn}:</span>
        <button
          type="button"
          data-hero-location-btn
          data-location-original={locationLabel}
          aria-label={profile.location}
          class="inline-flex min-h-11 items-center border-0 bg-transparent p-0 text-left font-mono-tech text-xs tracking-[0.1em] uppercase text-[var(--text-primary)] transition-colors hover:text-[var(--text-muted)]"
        >
          <span aria-hidden="true" data-hero-location-text>{locationLabel}</span>
        </button>
      </div>

      <div class="hidden h-8 w-px bg-[var(--border-strong)] sm:block" aria-hidden="true"></div>

      <time
        data-hero-clock
        class="inline-flex min-h-11 items-center tabular-nums text-[var(--text-primary)]"
      >
        {initialJakartaClock}
      </time>
    </div>
  </div>
</section>

<script>
  import { initLandingMotion } from '../../lib/motion/landing-motion';

  initLandingMotion();
</script>

