---
import type { ProjectItem } from '../../lib/content/types';

interface Props {
  heading?: string;
  projects: ProjectItem[];
  viewAllHref?: string;
  viewAllLabel?: string;
}

const { heading, projects, viewAllHref, viewAllLabel } = Astro.props;

const headingWords = (heading ?? '').trim().split(/\s+/).filter(Boolean);
const headingFirst = headingWords[0] ?? '';
const headingRest = headingWords.slice(1).join(' ');

const numericYears = projects
  .map((p) => Number.parseInt(String(p.year).replace(/[^0-9]/g, ''), 10))
  .filter((y) => Number.isFinite(y) && y >= 2000 && y <= 2100);
const minYear = numericYears.length > 0 ? Math.min(...numericYears) : 2024;
const maxYear = numericYears.length > 0 ? Math.max(...numericYears) : 2026;
const minShort = String(minYear).slice(-2);
const maxShort = String(maxYear).slice(-2);
const yearSpanLabel =
  minShort === maxShort
    ? `(PROJECTS / '${minShort})`
    : `(PROJECTS / '${minShort}-'${maxShort})`;
---

<section class="bg-[var(--bg-primary)] py-16 sm:py-24" data-work-section>
  <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-12">
    {
      heading && (
        <div class="mb-6 flex flex-wrap items-baseline justify-between gap-4 sm:mb-8">
          <h2 class="m-0 font-display text-2xl tracking-tight uppercase text-[var(--text-primary)] sm:text-3xl lg:text-[34px]">
            <span class="font-normal">{headingFirst}</span>
            {headingRest && (
              <>
                {' '}
                <span class="font-bold">{headingRest}</span>
              </>
            )}
          </h2>

          <span class="font-mono-tech text-[10px] tracking-[0.14em] uppercase text-[var(--text-muted)] sm:text-[11px]">
            {yearSpanLabel}
          </span>
        </div>
      )
    }

    <ul class="m-0 list-none bg-[var(--work-surface)] p-0">
      {
        projects.map((project, index) => {
          const num = String(index + 1).padStart(2, '0');
          const titleUpper = project.title.trim().toUpperCase();
          const stackText = project.tech_stack.map((t) => t.trim().toUpperCase()).join(', ');
          const hasBanner = Boolean(project.banner_url && project.banner_url.trim().length > 0);

          return (
            <li class="border-b border-[var(--work-divider)] last:border-b-0">
              <a
                href={project.external_url}
                target="_blank"
                rel="noopener noreferrer"
                data-project-row
                aria-label={`${project.title} (${project.tech_stack.join(', ')})`}
                class="group flex min-h-[108px] items-center gap-4 px-6 py-6 no-underline transition-colors duration-200 hover:bg-[var(--work-row-hover)] focus-visible:bg-[var(--work-row-hover)] sm:min-h-[120px] sm:gap-6 sm:px-8"
              >
                <span
                  aria-hidden="true"
                  data-symbol-scramble={num}
                  class="w-10 shrink-0 font-mono-tech text-xs tabular-nums whitespace-pre text-[var(--work-index-color)] sm:w-12"
                >
                  {num}
                </span>

                <div class="min-w-0 flex-1 pr-4">
                  <h3 class="m-0 truncate font-sans-ui text-lg font-medium tracking-[-0.01em] uppercase text-[var(--text-primary)] sm:text-2xl lg:text-[26px]">
                    <span class="whitespace-pre" data-symbol-scramble={titleUpper}>
                      {titleUpper}
                    </span>
                  </h3>
                  {stackText && (
                    <p
                      aria-hidden="true"
                      class="m-0 mt-1.5 truncate font-mono-tech text-[11px] tracking-[0.12em] uppercase text-[var(--work-stack-color)] md:hidden"
                    >
                      {stackText}
                    </p>
                  )}
                </div>

                <span
                  aria-hidden="true"
                  data-symbol-scramble={stackText}
                  class="hidden w-[220px] shrink-0 truncate font-mono-tech text-[11px] tracking-[0.12em] uppercase whitespace-pre text-[var(--work-stack-color)] sm:text-xs md:block lg:w-[280px]"
                >
                  {stackText}
                </span>

                <div
                  class="hidden h-[72px] w-[180px] shrink-0 items-center justify-end overflow-hidden lg:flex lg:h-[84px] lg:w-[230px]"
                  aria-hidden="true"
                >
                  {hasBanner && (
                    <img
                      src={project.banner_url}
                      alt=""
                      width="230"
                      height="84"
                      loading="lazy"
                      decoding="async"
                      class="work-thumb-preview pointer-events-none h-full w-full translate-x-2 scale-95 rounded-[2px] object-cover opacity-0 transition-all duration-300 ease-out group-hover:translate-x-0 group-hover:scale-100 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:scale-100 group-focus-visible:opacity-100"
                    />
                  )}
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>

    {
      viewAllHref && viewAllLabel && (
        <div class="mt-6 flex justify-end">
          <a
            href={viewAllHref}
            class="inline-flex min-h-11 items-center gap-2 font-mono-tech text-xs tracking-[0.12em] uppercase text-[var(--text-muted)] underline underline-offset-4 transition-colors hover:text-[var(--text-primary)]"
          >
            {viewAllLabel}
          </a>
        </div>
      )
    }
  </div>
</section>

<script>
  import { initSelectedWorkMotion } from '../../lib/motion/selected-work-motion';

  initSelectedWorkMotion();
</script>
