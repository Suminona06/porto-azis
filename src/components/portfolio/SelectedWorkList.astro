---
import type { ProjectItem } from '../../lib/content/types';

interface Props {
  heading?: string;
  projects: ProjectItem[];
  viewAllHref?: string;
  viewAllLabel?: string;
}

const { heading, projects, viewAllHref, viewAllLabel } = Astro.props;

const headingWords = (heading ?? '').trim().split(/\s+/).filter(Boolean);
const headingFirst = headingWords[0] ?? '';
const headingRest = headingWords.slice(1).join(' ');

const numericYears = projects
  .map((p) => Number.parseInt(String(p.year).replace(/[^0-9]/g, ''), 10))
  .filter((y) => Number.isFinite(y) && y >= 2000 && y <= 2100);
const minYear = numericYears.length > 0 ? Math.min(...numericYears) : 2024;
const maxYear = numericYears.length > 0 ? Math.max(...numericYears) : 2026;
const minShort = String(minYear).slice(-2);
const maxShort = String(maxYear).slice(-2);
const yearSpanLabel =
  minShort === maxShort
    ? `(PROJECTS / '${minShort})`
    : `(PROJECTS / '${minShort}-'${maxShort})`;
---

<section class="bg-[var(--bg-primary)] py-16 sm:py-24" data-work-section>
  <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-12">
    {
      heading && (
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4 sm:mb-10">
          <h2 class="m-0 font-display text-2xl leading-none tracking-[-0.03em] uppercase text-[var(--text-primary)] sm:text-3xl md:text-4xl">
            <span class="font-normal">{headingFirst}</span>
            {headingRest && (
              <>
                {' '}
                <span class="font-bold">{headingRest}</span>
              </>
            )}
          </h2>

          <span class="mb-1 font-mono-tech text-[10px] tracking-[0.14em] uppercase text-[var(--text-muted)] sm:text-[11px]">
            {yearSpanLabel}
          </span>
        </div>
      )
    }

    <ul class="m-0 flex list-none flex-col gap-0 bg-[var(--work-surface)] p-0">
      {
        projects.map((project, index) => {
          const num = String(index + 1).padStart(2, '0');
          const titleUpper = project.title.trim().toUpperCase();
          const stackText = project.tech_stack.map((t) => t.trim().toUpperCase()).join(', ');
          const hasBanner = Boolean(project.banner_url && project.banner_url.trim().length > 0);

          return (
            <li class="group/item m-0 p-0">
              <a
                href={project.external_url}
                target="_blank"
                rel="noopener noreferrer"
                data-project-row
                data-row-index={index}
                aria-label={`${project.title} (${project.tech_stack.join(', ')})`}
                class="work-row group relative isolate flex min-h-[104px] items-center overflow-hidden border-b border-[var(--work-divider)] no-underline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[var(--focus-ring)] group-last/item:border-b-0 md:h-[124px] lg:h-[132px]"
              >
                <div
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-0 z-0 bg-[var(--work-surface)]"
                />

                <div
                  aria-hidden="true"
                  data-work-layer
                  class="work-layer pointer-events-none absolute inset-0 z-10 flex items-center justify-end px-4"
                  style="clip-path: inset(100% 0% 0% 0%);"
                >
                  <div class="absolute inset-0 bg-[var(--work-curtain-bg)]" />
                  <div class="relative z-10 hidden h-[75%] w-[190px] shrink-0 overflow-hidden md:block lg:w-[210px] xl:w-[220px]">
                    {hasBanner && (
                      <img
                        src={project.banner_url}
                        alt=""
                        width="220"
                        height="99"
                        loading="lazy"
                        decoding="async"
                        data-work-thumb
                        class="work-thumb-preview pointer-events-none block h-full w-full object-cover"
                      />
                    )}
                  </div>
                </div>

                <div class="relative z-20 flex w-full flex-col justify-center gap-1.5 px-4 py-5 text-white mix-blend-difference md:grid md:h-full md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] md:items-center md:gap-4 md:px-6 md:py-0">
                  <div class="flex min-w-0 items-center justify-between md:hidden">
                    <span
                      aria-hidden="true"
                      data-symbol-scramble={num}
                      class="font-mono-tech text-xs font-medium tabular-nums text-white underline-offset-4 group-hover:underline"
                    >
                      {num}
                    </span>
                    {stackText && (
                      <span
                        aria-hidden="true"
                        class="truncate pl-4 font-mono-tech text-[11px] font-medium tracking-[0.06em] uppercase text-white"
                      >
                        {stackText}
                      </span>
                    )}
                  </div>

                  <div class="flex min-w-0 items-center md:gap-7 lg:gap-8 md:pr-4">
                    <span
                      aria-hidden="true"
                      data-symbol-scramble={num}
                      class="hidden w-7 shrink-0 font-mono-tech text-sm font-medium tabular-nums whitespace-pre text-white underline-offset-4 group-hover:underline md:inline-block"
                    >
                      {num}
                    </span>

                    <h3 class="m-0 min-w-0 flex-1 overflow-hidden font-sans-ui text-xl leading-[1.15] font-semibold tracking-[-0.025em] uppercase text-white sm:text-2xl lg:text-[26px] xl:text-[28px]">
                      <span class="block truncate" data-symbol-scramble={titleUpper}>
                        {titleUpper}
                      </span>
                    </h3>
                  </div>

                  <div class="hidden min-w-0 md:flex md:items-center">
                    <span
                      aria-hidden="true"
                      data-symbol-scramble={stackText}
                      class="inline-block max-w-full truncate font-mono-tech text-xs font-medium tracking-[0.06em] uppercase whitespace-nowrap text-white lg:text-[13px] xl:text-sm"
                    >
                      {stackText}
                    </span>
                  </div>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>

    {
      viewAllHref && viewAllLabel && (
        <div class="mt-6 flex justify-end">
          <a
            href={viewAllHref}
            class="inline-flex min-h-11 items-center gap-2 font-mono-tech text-xs tracking-[0.12em] uppercase text-[var(--text-muted)] underline underline-offset-4 transition-colors hover:text-[var(--text-primary)]"
          >
            {viewAllLabel}
          </a>
        </div>
      )
    }
  </div>
</section>

<script>
  import { initSelectedWorkMotion } from '../../lib/motion/selected-work-motion';

  initSelectedWorkMotion();
</script>
