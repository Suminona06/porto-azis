---
import { pickLocale, type Locale } from '../../lib/content/i18n';
import type { ActivityItem } from '../../lib/content/types';

interface Props {
  activities: ActivityItem[];
  locale: Locale;
}

const { activities, locale } = Astro.props;

function stripSamplePrefix(value: string): string {
  return value.replace(/^\[(?:SAMPLE|PLACEHOLDER)\]\s*/i, '').trim();
}
---

{
  activities.length === 0 ? (
    <div class="border-t border-[var(--about-divider)] py-10 font-mono-tech text-xs tracking-[0.08em] uppercase text-[var(--activities-sub-ink)]">
      {locale === 'id' ? 'Belum ada aktivitas yang dipublikasikan.' : 'No milestones published yet.'}
    </div>
  ) : (
    <div class="relative" data-activities-deck>
      {
        activities.map((item, idx) => {
          const title = stripSamplePrefix(pickLocale(item.title_en, item.title_id, locale));
          const subtitle = stripSamplePrefix(pickLocale(item.subtitle_en, item.subtitle_id, locale));
          const description = stripSamplePrefix(
            pickLocale(item.description_en, item.description_id, locale),
          );
          const num = String(idx + 1).padStart(2, '0');
          const hasRealImage =
            Boolean(item.image_url) && item.image_url !== '/placeholders/activity-placeholder.svg';

          return (
            <article
              id={`activity-card-${item.id}`}
              data-activity-card
              data-activity-index={idx}
              style={`--card-index: ${idx}; z-index: ${10 + idx};`}
              class="group sticky bg-[#0A0A0A]"
            >
              <button
                type="button"
                data-activity-header
                aria-label={`/${num} ${title} (${item.category} ${item.year})`}
                class="flex h-11 w-full cursor-pointer select-none items-center justify-between gap-4 border-t border-[#262626] bg-[#0A0A0A] px-4 text-left focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-white sm:h-12 sm:px-6"
              >
                <div class="flex min-w-0 items-center gap-3 sm:gap-4">
                  <span class="shrink-0 font-mono-tech text-[11px] tracking-[0.06em] text-[#737373]">
                    /{num}
                  </span>
                  <span class="truncate font-sans-ui text-xs font-semibold tracking-[0.02em] uppercase text-[#D4D4D4] transition-colors duration-300 group-hover:text-[#FFFFFF] group-focus-within:text-[#FFFFFF] sm:text-sm lg:text-[16px]">
                    {title}
                  </span>
                </div>

                <div class="flex shrink-0 items-center gap-2.5 font-mono-tech text-[10px] tracking-[0.08em] uppercase text-[#8A8A8A] sm:gap-3 sm:text-[11px]">
                  <span class="hidden min-[480px]:inline">{item.category}</span>
                  <span class="hidden min-[480px]:inline" aria-hidden="true">
                    •
                  </span>
                  <span>{item.year}</span>
                  <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-white" />
                </div>
              </button>

              <div class="relative h-[360px] w-full overflow-hidden bg-[#111111] sm:h-[460px] lg:h-[540px]">
                {hasRealImage ? (
                  <img
                    src={item.image_url}
                    alt={title}
                    width="1280"
                    height="720"
                    loading="eager"
                    decoding="async"
                    data-activity-media
                    class="h-full w-full object-cover object-center transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.02]"
                  />
                ) : (
                  <div
                    aria-hidden="true"
                    data-activity-media
                    class="activity-monochrome-fallback h-full w-full bg-[#141414] transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.02]"
                  />
                )}

                <div
                  aria-hidden="true"
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-black/15"
                />

                <div class="absolute inset-x-0 bottom-0 p-5 sm:p-7 lg:p-9">
                  <div class="max-w-[540px]">
                    {subtitle && (
                      <p class="m-0 mb-2 font-mono-tech text-[10px] tracking-[0.08em] uppercase text-[#D4D4D4] sm:text-[11px]">
                        {subtitle}
                      </p>
                    )}
                    {description && (
                      <p class="m-0 mb-4 font-sans-ui text-xs leading-[1.55] text-[#EDEDED] sm:text-sm lg:text-[15px]">
                        {description}
                      </p>
                    )}
                    <div class="flex items-center justify-between gap-4 border-t border-white/25 pt-2.5 font-mono-tech text-[10px] tracking-[0.08em] uppercase text-[#A3A3A3] sm:text-[11px]">
                      <span>{item.location}</span>
                      <span>{item.year}</span>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  )
}
