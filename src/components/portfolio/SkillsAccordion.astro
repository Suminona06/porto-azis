---
import { pickLocale, type Locale } from '../../lib/content/i18n';
import type { SkillGroup } from '../../lib/content/types';

interface Props {
  groups: SkillGroup[];
  locale: Locale;
}

const { groups, locale } = Astro.props;
---

<div class="border-t border-[var(--border-strong)]" data-accordion-group>
  {
    groups.map((group, idx) => {
      const title = pickLocale(group.title_en, group.title_id, locale);
      const panelId = `skill-panel-${group.id}`;
      const num = String(idx + 1).padStart(2, '0');
      const expanded = idx === 0;
      return (
        <div class="border-b border-[var(--border-light)]" data-accordion-item>
          <button
            type="button"
            aria-expanded={expanded ? 'true' : 'false'}
            aria-controls={panelId}
            data-accordion-trigger
            class="flex min-h-16 w-full items-center justify-between gap-4 bg-transparent px-2 py-5 text-left text-[var(--text-primary)] transition-colors hover:bg-[var(--bg-primary)] sm:px-4"
          >
            <span class="flex items-baseline gap-4">
              <span class="font-mono-tech text-xs tracking-[0.1em] text-[var(--text-muted)]">
                /{num}
              </span>
              <span class="font-sans-ui text-lg font-semibold sm:text-xl">
                {title}
              </span>
            </span>
            <span
              data-accordion-symbol
              aria-hidden="true"
              class="inline-flex h-8 w-8 shrink-0 items-center justify-center border border-[var(--border-light)] font-mono-tech text-base"
            >
              {expanded ? '-' : '+'}
            </span>
          </button>

          <div
            id={panelId}
            data-accordion-panel
            hidden={!expanded}
            class="px-2 pb-6 sm:px-4 sm:pl-14"
          >
            <ul class="m-0 flex list-none flex-wrap gap-2.5 p-0">
              {group.items.map((item) => (
                <li class="border border-[var(--border-light)] bg-[var(--bg-primary)] px-3.5 py-2 font-mono-tech text-xs tracking-[0.06em] uppercase text-[var(--text-secondary)]">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      );
    })
  }
</div>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-accordion-trigger]').forEach(function (btn) {
      if (btn.getAttribute('data-bound') === 'true') return;
      btn.setAttribute('data-bound', 'true');

      btn.addEventListener('click', function () {
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        const panelId = btn.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        const symbol = btn.querySelector('[data-accordion-symbol]');

        btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        if (symbol) symbol.textContent = isOpen ? '+' : '-';
        if (panel) {
          if (isOpen) {
            panel.setAttribute('hidden', '');
          } else {
            panel.removeAttribute('hidden');
          }
        }
      });
    });
  })();
</script>

