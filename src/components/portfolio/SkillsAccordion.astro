---
import { pickLocale, type Locale } from '../../lib/content/i18n';
import type { SkillGroup } from '../../lib/content/types';

interface Props {
  groups: SkillGroup[];
  locale: Locale;
}

const { groups, locale } = Astro.props;
---

<div class="border-t border-[var(--tech-divider)]" data-tech-accordion-group data-tech-reveal>
  {
    groups.map((group) => {
      const title = pickLocale(group.title_en, group.title_id, locale);
      const panelId = `skill-panel-${group.id}`;
      return (
        <div class="border-b border-[var(--tech-divider)]" data-tech-accordion-item>
          <button
            type="button"
            aria-expanded="false"
            aria-controls={panelId}
            data-tech-accordion-trigger
            class="group flex w-full items-center justify-between gap-6 bg-transparent px-0 py-5 text-left text-[var(--tech-row-muted)] transition-colors duration-300 ease-out hover:text-[var(--text-primary)] focus-visible:text-[var(--text-primary)] aria-expanded:text-[var(--text-primary)] lg:py-6"
          >
            <span class="font-sans-ui text-base font-medium uppercase tracking-[0.02em] sm:text-lg lg:text-[19px]">
              {title}
            </span>

            <span aria-hidden="true" class="inline-flex shrink-0 items-center justify-center">
              <svg
                width="15"
                height="15"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                class="block h-[15px] w-[15px]"
              >
                <line x1="2" y1="8" x2="14" y2="8" />
                <line
                  data-accordion-symbol-vert
                  x1="8"
                  y1="2"
                  x2="8"
                  y2="14"
                  class="origin-center transition-[transform,opacity] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-aria-expanded:rotate-90 group-aria-expanded:opacity-0"
                />
              </svg>
            </span>
          </button>

          <div
            id={panelId}
            data-tech-accordion-panel
            hidden
            class="overflow-hidden"
          >
            <ul class="m-0 flex list-none flex-col items-start space-y-2.5 p-0 pt-1 pb-6">
              {group.items.map((item) => (
                <li
                  data-tech-item
                  class="font-mono-tech text-[11px] leading-relaxed tracking-[0.08em] uppercase text-[var(--tech-item-muted)] transition-colors duration-200 hover:text-[var(--text-primary)] sm:text-xs"
                >
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      );
    })
  }
</div>
