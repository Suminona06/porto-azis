---
import { pickLocale, type Locale } from '../../lib/content/i18n';
import type { SkillGroup } from '../../lib/content/types';

interface Props {
  groups: SkillGroup[];
  locale: Locale;
}

const { groups, locale } = Astro.props;
---

<div class="border-t border-[var(--tech-divider)]" data-tech-accordion-group data-tech-reveal>
  {
    groups.map((group) => {
      const title = pickLocale(group.title_en, group.title_id, locale);
      const panelId = `skill-panel-${group.id}`;
      return (
        <div class="border-b border-[var(--tech-divider)]" data-tech-accordion-item>
          <button
            type="button"
            aria-expanded="false"
            aria-controls={panelId}
            data-tech-accordion-trigger
            class="group flex w-full items-center justify-between gap-6 bg-transparent px-0 py-3.5 text-left text-[var(--text-primary)] transition-colors duration-300 ease-out hover:text-[var(--tech-row-muted)] focus-visible:text-[var(--tech-row-muted)] lg:py-4"
          >
            <span class="font-sans-ui text-[15px] leading-snug font-medium tracking-[0.015em] uppercase sm:text-base lg:text-[18px]">
              {title}
            </span>

            <span aria-hidden="true" class="inline-flex shrink-0 items-center justify-center">
              <svg
                data-accordion-icon
                width="14"
                height="14"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                class="block h-[14px] w-[14px]"
                style="transform-box: fill-box; transform-origin: center;"
              >
                <line x1="2" y1="8" x2="14" y2="8" />
                <line
                  data-accordion-symbol-vert
                  x1="8"
                  y1="2"
                  x2="8"
                  y2="14"
                  style="transform-box: fill-box; transform-origin: center;"
                />
              </svg>
            </span>
          </button>

          <div
            id={panelId}
            data-tech-accordion-panel
            hidden
            class="overflow-hidden"
          >
            <ul class="m-0 flex list-none flex-col items-start space-y-1.5 p-0 pt-0.5 pb-4">
              {group.items.map((item) => (
                <li
                  data-tech-item
                  class="font-mono-tech text-[10px] leading-snug tracking-[0.08em] uppercase text-[var(--tech-item-muted)] transition-colors duration-200 hover:text-[var(--text-primary)] sm:text-[11px]"
                >
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      );
    })
  }
</div>
