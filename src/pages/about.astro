---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillsAccordion from '../components/portfolio/SkillsAccordion.astro';
import ActivitiesList from '../components/portfolio/ActivitiesList.astro';
import ContactBanner from '../components/portfolio/ContactBanner.astro';
import { getUiCopy, pickLocale } from '../lib/content/i18n';
import { createSupabaseServerClient } from '../lib/supabase/server';
import { fetchAboutData, fetchSiteProfile } from '../lib/supabase/queries';

export const prerender = false;

const locale = Astro.locals.locale;
const copy = getUiCopy(locale);
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

const [profileRes, aboutRes] = await Promise.all([
  fetchSiteProfile(supabase),
  fetchAboutData(supabase),
]);

const profile = profileRes.data;
const { sections, skillGroups, activities } = aboutRes.data;
const isPlaceholder = profileRes.isPlaceholder || aboutRes.isPlaceholder;

const headline = pickLocale(sections.headline_en, sections.headline_id, locale);
const journeyParagraphs = pickLocale(sections.journey_en, sections.journey_id, locale)
  .split(/\n\n+/)
  .map((p) => p.trim())
  .filter(Boolean);
const philosophy = pickLocale(sections.philosophy_en, sections.philosophy_id, locale);
const interest = pickLocale(sections.interest_en, sections.interest_id, locale);
---

<BaseLayout
  title={`${copy.navAbout} - ${profile.display_name}`}
  description={headline}
  locale={locale}
  currentPath={Astro.url.pathname + Astro.url.search}
  fullName="Azis Muhamad Fadli"
  wordmark={profile.wordmark}
  socialLinks={profile.social_links}
>
  <section class="border-b border-[var(--border-light)] bg-[var(--bg-primary)] py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
      {
        isPlaceholder && (
          <div
            role="note"
            class="mb-8 border border-[var(--border-light)] bg-[var(--bg-alt)] px-4 py-2.5 font-mono-tech text-xs tracking-[0.06em] text-[var(--text-muted)]"
          >
            {copy.placeholderNotice}
          </div>
        )
      }

      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="m-0 mb-4 font-mono-tech text-xs tracking-[0.14em] uppercase text-[var(--text-muted)]">
            /02 {copy.aboutTagEngineer}
          </p>
          <h1 class="m-0 font-display text-[clamp(2rem,4.5vw,3.75rem)] leading-[1.1] font-semibold tracking-[-0.02em] text-[var(--text-primary)]">
            {headline}
          </h1>
        </div>

        <div class="lg:col-span-5">
          <div class="mx-auto max-w-sm border border-[var(--border-light)] bg-[var(--bg-alt)] p-3 lg:ml-auto lg:mr-0">
            <div class="aspect-[3/4] w-full overflow-hidden border border-[var(--border-light)]">
              <img
                src={sections.profile_image_url || '/placeholders/profile-placeholder.svg'}
                alt="Azis Muhamad Fadli portrait"
                width="600"
                height="800"
                fetchpriority="high"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--border-light)] bg-[var(--bg-primary)] py-16 sm:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:px-10">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-24">
          <p class="m-0 mb-3 font-mono-tech text-xs tracking-[0.14em] uppercase text-[var(--text-muted)]">
            /00-1
          </p>
          <h2 class="m-0 font-display text-3xl leading-[1.12] font-semibold uppercase text-[var(--text-primary)] sm:text-4xl">
            {copy.aboutProgressionHeading}
          </h2>
        </div>
      </div>

      <div class="space-y-6 lg:col-span-7">
        {
          journeyParagraphs.map((paragraph) => (
            <p class="m-0 max-w-2xl font-sans-ui text-base leading-[1.75] text-[var(--text-secondary)] sm:text-[17px]">
              {paragraph}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--border-light)] bg-[var(--bg-alt)] py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
      <p class="m-0 mb-4 font-mono-tech text-xs tracking-[0.14em] uppercase text-[var(--text-muted)]">
        /00-2
      </p>
      <h2 class="m-0 mb-12 max-w-5xl font-display text-[clamp(1.65rem,3.6vw,3rem)] leading-[1.18] font-semibold uppercase text-[var(--text-primary)]">
        {philosophy}
      </h2>

      <SkillsAccordion groups={skillGroups} locale={locale} />
    </div>
  </section>

  <section class="border-b border-[var(--border-light)] bg-[var(--bg-primary)] py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
      <p class="m-0 mb-3 font-mono-tech text-xs tracking-[0.14em] uppercase text-[var(--text-muted)]">
        /00-3
      </p>
      <h2 class="m-0 mb-10 font-display text-3xl leading-[1.1] font-semibold uppercase text-[var(--text-primary)] sm:text-4xl">
        {copy.aboutActivitiesHeading}
      </h2>

      <ActivitiesList activities={activities} locale={locale} />
    </div>
  </section>

  <section class="border-b border-[var(--border-light)] bg-[var(--bg-alt)] py-16 sm:py-24">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:items-center lg:px-10">
      <div class="lg:col-span-5">
        <p class="m-0 mb-3 font-mono-tech text-xs tracking-[0.14em] uppercase text-[var(--text-muted)]">
          /00-4
        </p>
        <h2 class="m-0 mb-5 font-display text-3xl leading-[1.1] font-semibold uppercase text-[var(--text-primary)] sm:text-4xl">
          {copy.aboutPersonalInterestHeading}
        </h2>
        <p class="m-0 max-w-lg font-sans-ui text-base leading-[1.75] text-[var(--text-secondary)] sm:text-[17px]">
          {interest}
        </p>
      </div>

      <div class="lg:col-span-7">
        <div class="border border-[var(--border-light)] bg-[var(--bg-primary)] p-3">
          <div class="aspect-[4/3] w-full overflow-hidden border border-[var(--border-light)]">
            <img
              src={sections.interest_image_url || '/placeholders/interest-placeholder.svg'}
              alt="Homelab and infrastructure tinkering"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactBanner
    eyebrow="/00-5"
    title={copy.homeCtaTitle}
    subtitle={copy.homeCtaSubtitle}
    ctaLabel={copy.aboutCtaButton}
    ctaUrl={profile.contact_url}
  />
</BaseLayout>

