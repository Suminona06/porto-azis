---
import BaseLayout from '../layouts/BaseLayout.astro';
import CipherText from '../components/motion/CipherText.astro';
import BlockMaskReveal from '../components/motion/BlockMaskReveal.astro';
import ImageCurtainReveal from '../components/motion/ImageCurtainReveal.astro';
import SkillsAccordion from '../components/portfolio/SkillsAccordion.astro';
import ActivitiesList from '../components/portfolio/ActivitiesList.astro';
import {
  getUiCopy,
  normalizeSentenceCase,
  pickLocale,
  splitHeadlineLockup,
  splitInterestParagraphs,
  splitJourneyParagraphs,
} from '../lib/content/i18n';
import { PLACEHOLDER_ABOUT } from '../lib/content/placeholder';
import { createSupabaseServerClient } from '../lib/supabase/server';
import { fetchAboutData, fetchSiteProfile } from '../lib/supabase/queries';

export const prerender = false;

const locale = Astro.locals.locale;
const copy = getUiCopy(locale);
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

const [profileRes, aboutRes] = await Promise.all([
  fetchSiteProfile(supabase),
  fetchAboutData(supabase),
]);

const profile = profileRes.data;
const { sections, skillGroups, activities } = aboutRes.data;

const rawHeadline = pickLocale(sections.headline_en, sections.headline_id, locale);
const [heroLine1, heroLine2] = splitHeadlineLockup(
  rawHeadline,
  profile.display_name,
  pickLocale(profile.role_en, profile.role_id, locale),
);

const journeyParagraphs = splitJourneyParagraphs(
  pickLocale(sections.journey_en, sections.journey_id, locale),
);
const philosophy = normalizeSentenceCase(
  pickLocale(sections.philosophy_en, sections.philosophy_id, locale),
);
const defaultInterestParagraphs = splitJourneyParagraphs(
  pickLocale(PLACEHOLDER_ABOUT.sections.interest_en, PLACEHOLDER_ABOUT.sections.interest_id, locale),
);
const [interestParagraph1, interestParagraph2] = splitInterestParagraphs(
  pickLocale(sections.interest_en, sections.interest_id, locale),
  defaultInterestParagraphs[1] ?? '',
);
const interestParagraph1Words = interestParagraph1.split(/\s+/).filter(Boolean);
const interestParagraph2Words = interestParagraph2.split(/\s+/).filter(Boolean);
const interestImageSrc = sections.interest_image_url || '/placeholders/interest-placeholder.svg';
const isHttpContact = /^https?:\/\//i.test(profile.contact_url);
const aboutCtaLabel = copy.aboutCtaButton.replace(/\s*→\s*$/, '');
---

<BaseLayout
  title={`${copy.navAbout} - ${profile.display_name}`}
  description={`${heroLine1} - ${heroLine2}`}
  locale={locale}
  currentPath={Astro.url.pathname + Astro.url.search}
  fullName="Azis Muhamad Fadli"
  wordmark={profile.wordmark}
  socialLinks={profile.social_links}
  flushTop={true}
>
  <section class="bg-[var(--bg-primary)]" data-about-hero>
    <div class="mx-auto flex min-h-[100svh] max-w-7xl flex-col justify-between gap-10 px-6 pt-32 pb-6 sm:px-10 sm:pt-40 lg:px-12 lg:pt-44 lg:pb-8">
      <div>
        <div class="flex items-center justify-between gap-4 font-mono-tech text-[11px] tracking-[0.2em] uppercase text-[var(--about-meta-ink)]">
          <span>{copy.basedIn}</span>
          <span>{copy.aboutTagEngineer}</span>
        </div>

        <h1 class="m-0 mt-5 sm:mt-6">
          <CipherText
            text={heroLine1}
            as="span"
            durationMs={800}
            frameIntervalMs={36}
            charset="alnum"
            trigger="manual"
            data-about-cipher
            class="block font-display text-[clamp(1.75rem,3.4vw,3.1rem)] leading-[1.08] font-normal tracking-tight uppercase text-[var(--text-primary)]"
          />
          <span class="mt-1.5 ml-[6%] block sm:mt-2 md:ml-[7.5%]">
            <BlockMaskReveal
              durationMs={700}
              trigger="manual"
              data-about-mask
              class="font-sans-ui text-[clamp(1.45rem,2.9vw,2.65rem)] leading-[1.1] font-bold tracking-tight uppercase text-[var(--text-primary)]"
            >
              {heroLine2}
            </BlockMaskReveal>
          </span>
        </h1>
      </div>

      <div class="mt-auto flex justify-end">
        <ImageCurtainReveal
          durationMs={700}
          trigger="manual"
          data-about-curtain
          class="aspect-[3/4] w-[210px] rounded-none sm:w-[240px] lg:w-[280px]"
        >
          <img
            src={sections.profile_image_url || '/placeholders/profile-placeholder.svg'}
            alt="Azis Muhamad Fadli portrait"
            width="560"
            height="747"
            fetchpriority="high"
            decoding="async"
            class="h-full w-full rounded-none object-cover grayscale contrast-105"
          />
        </ImageCurtainReveal>
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--about-divider)] bg-[var(--bg-primary)] py-24 lg:py-36">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-y-10 px-6 sm:px-10 lg:grid-cols-12 lg:gap-x-8 lg:px-12">
      <div class="self-start lg:sticky lg:top-32 lg:col-span-5">
        <h2 class="m-0 font-display text-2xl leading-[1.15] font-normal tracking-tight uppercase text-[var(--text-primary)] sm:text-[1.75rem] xl:text-[2rem]">
          {copy.aboutProgressionHeading}
        </h2>
      </div>

      <div
        class="flex max-w-[52ch] flex-col gap-6 font-sans-ui text-[14px] leading-[1.68] md:text-[15px] lg:col-span-5 lg:col-start-8"
        data-journey-journal
      >
        {
          journeyParagraphs.map((paragraph) => {
            const words = paragraph.split(/\s+/).filter(Boolean);
            return (
              <p class="m-0">
                {words.map((word, idx) => (
                  <>
                    <span data-journey-word class="inline">
                      {word}
                    </span>
                    {idx < words.length - 1 ? ' ' : ''}
                  </>
                ))}
              </p>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="border-b border-[var(--about-divider)] bg-[var(--bg-primary)] pb-20 lg:pb-28" data-tech-stack-section>
    <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-12">
      <div class="pt-20 pb-14 lg:pt-28 lg:pb-16">
        <p
          class="m-0 mb-4 font-mono-tech text-[11px] tracking-[0.08em] uppercase text-[var(--about-meta-ink)]"
          data-tech-reveal
        >
          /00-2
        </p>
        <h2
          class="m-0 max-w-[44ch] font-sans-ui text-xl leading-[1.38] font-normal tracking-[-0.01em] text-[var(--text-primary)] sm:text-2xl lg:text-[26px]"
          data-tech-reveal
        >
          {philosophy}
        </h2>
      </div>

      <SkillsAccordion groups={skillGroups} locale={locale} />
    </div>
  </section>

  <section class="border-b border-[var(--about-divider)] bg-[var(--bg-primary)] py-20 lg:py-28" data-activities-section>
    <div class="mx-auto max-w-7xl px-6 sm:px-10 lg:px-12">
      <div>
        <p
          class="m-0 mb-3 font-mono-tech text-[11px] tracking-[0.08em] uppercase text-[var(--about-meta-ink)]"
          data-activities-reveal
        >
          /00-3
        </p>
        <h2
          class="m-0 font-display text-3xl leading-[1.08] font-normal tracking-[-0.01em] uppercase text-[var(--text-primary)] sm:text-4xl lg:text-[42px]"
          data-activities-reveal
        >
          {copy.aboutActivitiesHeading}
        </h2>
        <div
          class="mt-3 mb-10 flex flex-col gap-2 font-mono-tech text-[10px] tracking-[0.08em] uppercase text-[var(--activities-sub-ink)] sm:flex-row sm:items-center sm:justify-between sm:text-[11px] lg:mb-14"
          data-activities-reveal
        >
          <span>{copy.aboutActivitiesKeywords}</span>
          <span>{copy.aboutActivitiesSpan}</span>
        </div>
      </div>

      <ActivitiesList activities={activities} locale={locale} />
    </div>
  </section>

  <section class="bg-[var(--bg-primary)] py-24 sm:py-32 lg:py-40" data-interest-section>
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-y-8 px-6 sm:px-10 lg:grid-cols-12 lg:gap-x-12 lg:px-12">
      <div class="self-start lg:col-span-4">
        <span class="m-0 mb-3 block font-mono-tech text-[11px] tracking-[0.08em] uppercase text-[var(--about-meta-ink)]">
          /00-4
        </span>
        <h2 class="m-0 font-display text-3xl leading-[1.08] font-normal tracking-[-0.01em] uppercase text-[var(--text-primary)] sm:text-4xl lg:text-[42px]">
          <span class="block">{copy.aboutPersonalInterestLine1}</span>
          <span class="block">{copy.aboutPersonalInterestLine2}</span>
        </h2>
      </div>

      <div class="lg:col-span-8">
        {
          interestParagraph1Words.length > 0 && (
            <p
              class="m-0 max-w-[60ch] font-sans-ui text-sm leading-[1.65] font-normal text-[var(--text-primary)] sm:text-base lg:text-[16px]"
              data-interest-paragraph="1"
            >
              {interestParagraph1Words.map((word, idx) => (
                <>
                  <span data-interest-word class="inline">
                    {word}
                  </span>
                  {idx < interestParagraph1Words.length - 1 ? ' ' : ''}
                </>
              ))}
            </p>
          )
        }

        <div
          class="group relative mt-8 aspect-[16/10] w-full overflow-hidden rounded-none bg-[#111111] sm:aspect-[16/9] lg:mt-10"
          data-interest-media-frame
        >
          <div
            class="relative h-full w-full transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.02]"
            data-interest-media-zoom
          >
            <img
              src={interestImageSrc}
              alt={
                locale === 'id'
                  ? 'Eksperimen homelab dan ruang kerja teknis'
                  : 'Homelab and personal infrastructure setup'
              }
              width="1280"
              height="720"
              loading="eager"
              decoding="async"
              data-interest-media
              data-interest-parallax
              class="absolute inset-x-0 -top-[24%] h-[148%] w-full object-cover object-center will-change-transform"
            />
          </div>
        </div>

        {
          interestParagraph2Words.length > 0 && (
            <p
              class="m-0 mt-8 max-w-[60ch] font-sans-ui text-sm leading-[1.65] font-normal text-[var(--text-primary)] sm:text-base lg:mt-10 lg:ml-auto lg:w-[73%] lg:max-w-none lg:text-[16px]"
              data-interest-paragraph="2"
            >
              {interestParagraph2Words.map((word, idx) => (
                <>
                  <span data-interest-word class="inline">
                    {word}
                  </span>
                  {idx < interestParagraph2Words.length - 1 ? ' ' : ''}
                </>
              ))}
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section
    class="border-t border-[var(--border-light)] bg-[var(--bg-primary)] py-24 sm:py-32 lg:py-40"
    data-closing-cta-section
  >
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-start gap-y-8 px-6 sm:px-10 lg:grid-cols-12 lg:gap-x-8 lg:px-12">
      <div
        aria-hidden="true"
        class="pointer-events-none hidden pt-14 font-mono-tech text-[11px] leading-relaxed tracking-[0.14em] uppercase select-none text-[var(--about-watermark-ink)] lg:col-span-6 lg:flex lg:flex-col xl:col-span-7"
      >
        <span class="lg:ml-[10%] xl:ml-[12%]">{profile.display_name}</span>
        <span class="mt-10 self-center lg:ml-[18%]">{copy.aboutClosingWatermarkRole}</span>
      </div>

      <div class="lg:col-span-6 xl:col-span-5">
        <span class="m-0 mb-3.5 block font-mono-tech text-[11px] tracking-[0.08em] uppercase text-[var(--about-meta-ink)]">
          /00-5
        </span>

        <h2 class="m-0 font-sans-ui text-xl leading-[1.24] font-medium tracking-[-0.01em] uppercase text-[var(--text-primary)] sm:text-2xl lg:text-[22px] xl:text-[24px]">
          <span class="block">{copy.aboutClosingLine1}</span>
          <span class="block">{copy.aboutClosingLine2}</span>
          <span class="block">{copy.aboutClosingLine3}</span>
        </h2>

        <div class="mt-7 lg:mt-8">
          <a
            href={profile.contact_url}
            target={isHttpContact ? '_blank' : undefined}
            rel={isHttpContact ? 'noopener noreferrer' : undefined}
            data-closing-cta-link
            class="closing-cta-link group -my-2 inline-flex min-h-[44px] items-center py-2 font-mono-tech text-xs font-semibold tracking-[0.08em] uppercase text-[var(--about-cta-ink)] transition-colors duration-500 hover:text-[var(--text-primary)] focus-visible:text-[var(--text-primary)] active:opacity-80"
          >
            <span class="relative inline-flex items-center gap-3.5 pb-2">
              <span>{aboutCtaLabel}</span>
              <svg
                aria-hidden="true"
                data-closing-cta-arrow
                class="closing-cta-arrow h-3.5 w-6 shrink-0"
                viewBox="0 0 24 14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.85"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M1 7h21" />
                <path d="M16.5 2L22 7l-5.5 5" />
              </svg>
              <span
                aria-hidden="true"
                data-closing-cta-underline
                class="closing-cta-underline pointer-events-none absolute right-0 bottom-0 left-0 h-[1.5px] bg-[var(--text-primary)]"
              />
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initAboutMotion } from '../lib/motion/about-motion';

  initAboutMotion();
</script>
