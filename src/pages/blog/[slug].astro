---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogToc from '../../components/blog/BlogToc.astro';
import MarkdownProse from '../../components/blog/MarkdownProse.astro';
import { getUiCopy } from '../../lib/content/i18n';
import { renderCozyMarkdown } from '../../lib/content/markdown';
import { createSupabaseServerClient } from '../../lib/supabase/server';
import {
  fetchPublishedPostBySlug,
  fetchPublishedPosts,
  fetchSiteProfile,
} from '../../lib/supabase/queries';

export const prerender = false;

const locale = Astro.locals.locale;
const copy = getUiCopy(locale);
const slug = Astro.params.slug || '';
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);

const [profileRes, postRes, allPostsRes] = await Promise.all([
  fetchSiteProfile(supabase),
  fetchPublishedPostBySlug(slug, supabase),
  fetchPublishedPosts(supabase),
]);

const profile = profileRes.data;
const post = postRes.post;

if (!post) {
  Astro.response.status = 404;
}

const rendered = post
  ? await renderCozyMarkdown(post.content_markdown, {
      copy: copy.blogCopyCode,
      copied: copy.blogCopiedCode,
    })
  : { html: '', toc: [] };

const allPosts = allPostsRes.posts;
const currentIndex = post ? allPosts.findIndex((p) => p.slug === post.slug) : -1;
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const nextPost =
  currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

function formatDate(iso: string | null): string {
  if (!iso) return '';
  try {
    return new Intl.DateTimeFormat('en-CA', {
      year: 'numeric',
      month: 'short',
      day: '2-digit',
    }).format(new Date(iso));
  } catch {
    return iso.slice(0, 10);
  }
}

const showLanguageNotice = Boolean(post && post.language !== locale);
const languageNoticeText =
  post?.language === 'id' ? copy.blogWrittenInIndonesian : copy.blogWrittenInEnglish;
---

<BaseLayout
  title={post ? `${post.title} - ${profile.display_name}` : `404 - ${profile.display_name}`}
  description={post?.excerpt || copy.blogPageSubtitle}
  locale={locale}
  currentPath={Astro.url.pathname + Astro.url.search}
  fullName="Azis Muhamad Fadli"
  wordmark={profile.wordmark}
  socialLinks={profile.social_links}
>
  {
    !post ? (
      <section class="bg-[var(--bg-primary)] py-24">
        <div class="mx-auto max-w-2xl px-4 text-center sm:px-6">
          <p class="m-0 font-mono-tech text-xs tracking-[0.14em] uppercase text-[var(--text-muted)]">
            404
          </p>
          <h1 class="mt-3 mb-4 font-display text-4xl font-semibold text-[var(--text-primary)]">
            {copy.blogNoMatchTitle}
          </h1>
          <p class="mb-8 font-sans-ui text-base text-[var(--text-secondary)]">
            {copy.blogEmptyBody}
          </p>
          <a href="/blog" class="button-primary">
            &larr; {copy.blogBackToIndex}
          </a>
        </div>
      </section>
    ) : (
      <article class="bg-[var(--bg-primary)] py-12 sm:py-16 lg:py-20">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-10">
          <div class="mb-8">
            <a
              href="/blog"
              class="inline-flex min-h-11 items-center gap-2 font-mono-tech text-xs tracking-[0.1em] uppercase text-[var(--text-muted)] no-underline hover:text-[var(--text-primary)]"
            >
              <span aria-hidden="true">&larr;</span>
              <span>{copy.blogBackToIndex}</span>
            </a>
          </div>

          <header class="mb-10 border-b border-[var(--border-light)] pb-8">
            <div class="mb-4 flex flex-wrap items-center gap-3 font-mono-tech text-xs tracking-[0.08em] uppercase text-[var(--text-muted)]">
              <span class="border border-[var(--border-light)] bg-[var(--bg-alt)] px-2.5 py-0.5 text-[var(--text-primary)]">
                {post.category}
              </span>
              <span class="border border-[var(--border-light)] px-2 py-0.5 text-[var(--text-secondary)]">
                {post.language.toUpperCase()}
              </span>
              {post.published_at && (
                <time datetime={post.published_at}>{formatDate(post.published_at)}</time>
              )}
              <span>
                {post.reading_minutes} {copy.blogReadingTimeSuffix}
              </span>
            </div>

            <h1 class="m-0 max-w-4xl font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.1] font-semibold tracking-[-0.02em] text-[var(--text-primary)]">
              {post.title}
            </h1>

            {post.excerpt && (
              <p class="mt-4 mb-0 max-w-[68ch] font-sans-ui text-lg leading-[1.6] text-[var(--text-secondary)]">
                {post.excerpt}
              </p>
            )}

            {showLanguageNotice && (
              <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border border-[var(--border-light)] bg-[var(--bg-alt)] px-4 py-2.5 font-mono-tech text-xs text-[var(--text-muted)]">
                <span>{languageNoticeText}</span>
                {postRes.counterpartSlug && (
                  <a
                    href={`/blog/${postRes.counterpartSlug}`}
                    class="text-[var(--text-primary)] underline underline-offset-4"
                  >
                    {copy.blogReadTranslation}
                  </a>
                )}
              </div>
            )}
          </header>

          {post.cover_image_url && (
            <div class="mb-12 aspect-[16/9] w-full overflow-hidden border border-[var(--border-light)] bg-[var(--bg-alt)]">
              <img
                src={post.cover_image_url}
                alt={post.title}
                width="1200"
                height="675"
                fetchpriority="high"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
          )}

          <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-start">
            <div class="lg:col-span-4 lg:order-2">
              <BlogToc toc={rendered.toc} label={copy.blogTocLabel} />
            </div>

            <div class="lg:col-span-8 lg:order-1">
              <MarkdownProse html={rendered.html} />
            </div>
          </div>

          {(prevPost || nextPost) && (
            <nav
              aria-label="Article navigation"
              class="mt-16 grid grid-cols-1 gap-4 border-t border-[var(--border-strong)] pt-8 sm:grid-cols-2"
            >
              <div>
                {prevPost && (
                  <a
                    href={`/blog/${prevPost.slug}`}
                    class="block border border-[var(--border-light)] bg-[var(--bg-alt)] p-5 no-underline transition-colors hover:border-[var(--border-strong)]"
                  >
                    <span class="block font-mono-tech text-xs tracking-[0.1em] uppercase text-[var(--text-muted)]">
                      &larr; {copy.blogPrevArticle}
                    </span>
                    <span class="mt-2 block font-display text-lg font-semibold text-[var(--text-primary)]">
                      {prevPost.title}
                    </span>
                  </a>
                )}
              </div>
              <div>
                {nextPost && (
                  <a
                    href={`/blog/${nextPost.slug}`}
                    class="block border border-[var(--border-light)] bg-[var(--bg-alt)] p-5 text-right no-underline transition-colors hover:border-[var(--border-strong)]"
                  >
                    <span class="block font-mono-tech text-xs tracking-[0.1em] uppercase text-[var(--text-muted)]">
                      {copy.blogNextArticle} &rarr;
                    </span>
                    <span class="mt-2 block font-display text-lg font-semibold text-[var(--text-primary)]">
                      {nextPost.title}
                    </span>
                  </a>
                )}
              </div>
            </nav>
          )}
        </div>
      </article>
    )
  }
</BaseLayout>

